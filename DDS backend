// ENHANCED phone number validation and duplicate checking
function validatePhoneNumber(phone, country) {
  if (!phone || !country) return false;
  
  // Get expected country code
  const expectedCode = COUNTRY_CODES[country];
  if (!expectedCode) return false;
  
  // Normalize the phone number
  const normalizedPhone = normalizePhoneNumber(phone);
  
  // Check if phone starts with the country code
  if (!normalizedPhone.startsWith(expectedCode.replace('+', ''))) {
    return false;
  }
  
  // Additional length validation (most phone numbers are 10-15 digits including country code)
  const totalLength = normalizedPhone.length;
  if (totalLength < 8 || totalLength > 15) {
    return false;
  }
  
  return true;
}

// ENHANCED: Phone normalization that matches frontend
function normalizePhoneNumber(phoneNumber) {
  if (!phoneNumber) return '';
  
  try {
    let normalized = phoneNumber.toString().trim();
    
    // Remove all non-digit characters except leading +
    if (normalized.startsWith('+')) {
      normalized = '+' + normalized.substring(1).replace(/[^\d]/g, '');
      // Remove the + for storage consistency
      normalized = normalized.substring(1);
    } else {
      normalized = normalized.replace(/[^\d]/g, '');
    }
    
    console.log('Phone normalization:', phoneNumber, '->', normalized);
    return normalized;
    
  } catch (error) {
    console.error('Error normalizing phone number:', error);
    return phoneNumber.toString().replace(/[^\d]/g, '');
  }
}

