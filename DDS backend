function checkGameTimeouts() {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const gameSessionsSheet = ss.getSheetByName('DDS Game Sessions');
    
    if (!gameSessionsSheet) return;
    
    const values = gameSessionsSheet.getDataRange().getValues();
    const oneHourAgo = new Date(Date.now() - (60 * 60 * 1000));
    
    for (let i = values.length - 1; i >= 1; i--) {
      const lastActivity = new Date(values[i][6]);
      if (lastActivity < oneHourAgo && values[i][10] === 'in_progress') {
        // Game timed out - mark as lost
        gameSessionsSheet.getRange(i + 1, 11).setValue('timeout_loss');
        gameSessionsSheet.getRange(i + 1, 8).setValue('timeout');
      }
    }
  } catch (error) {
    console.log('Timeout check error:', error);
  }
}

