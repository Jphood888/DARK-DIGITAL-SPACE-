    if (!profileSheet) {
      return createGETResponse(false, 'No profiles found');
    }

    const values = profileSheet.getDataRange().getValues();
    const leaderboard = [];

    // Get post counts if needed
    const postCounts = {};
    if (category === 'posts') {
      const postsSheet = ss.getSheetByName(CONFIG.DDS_POSTS_SHEET);
      if (postsSheet) {
        const postValues = postsSheet.getDataRange().getValues();
        for (let i = 1; i < postValues.length; i++) {
          const ddsNumber = postValues[i][1];
          postCounts[ddsNumber] = (postCounts[ddsNumber] || 0) + 1;
        }
      }
    }

    for (let i = 1; i < values.length; i++) {
      const entry = {
        position: 0, // Will be set after sorting
        alias: values[i][1],
        rank: values[i][2],
        rankNumber: values[i][3],
        profession: values[i][4],
        bits: values[i][7],
        followers: values[i][5],
        likes: values[i][6],
        posts: postCounts[values[i][0]] || 0,
        avatar: values[i][9]
      };

      leaderboard.push(entry);
    }

    // Sort by selected category
    switch(category) {
      case 'followers':
        leaderboard.sort((a, b) => b.followers - a.followers);
        break;
      case 'likes':
        leaderboard.sort((a, b) => b.likes - a.likes);
        break;
      case 'posts':
        leaderboard.sort((a, b) => b.posts - a.posts);
        break;
      default: // bits
        leaderboard.sort((a, b) => b.bits - a.bits);
    }

    // Set positions
    leaderboard.forEach((entry, index) => {
      entry.position = index + 1;
    });

    return createGETResponse(true, 'Leaderboard retrieved', {
      leaderboard: leaderboard.slice(0, limit),
      category: category,
      total: leaderboard.length
    });

  } catch (error) {
    return createGETResponse(false, 'Error retrieving leaderboard: ' + error.toString());
  }
}

