      const postValues = postsSheet.getDataRange().getValues();
      for (let i = 1; i < postValues.length; i++) {
        if (postValues[i][1] === profile.ddsNumber) {
          postCount++;
        }
      }
    }

    // Calculate rank position within tier
    const profileSheet = ss.getSheetByName(CONFIG.DDS_PROFILES_SHEET);
    let rankPosition = 1;
