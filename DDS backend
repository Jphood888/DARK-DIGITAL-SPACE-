// 4. NEW FUNCTION: Fix existing users without proper ranks
function upgradeExistingUsersRanks() {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const profileSheet = ss.getSheetByName(CONFIG.DDS_PROFILES_SHEET);
    
    if (!profileSheet) {
      console.log('No profile sheet found');
      return createResponse(false, 'No profiles to upgrade');
    }
    
    const values = profileSheet.getDataRange().getValues();
    const usersToUpgrade = [];
    
    // Find users with default ranks (H100) or invalid ranks
    for (let i = 1; i < values.length; i++) {
      const rank = values[i][2];
      const rankNumber = values[i][3];
      const bits = values[i][7] || 0;
      const ddsNumber = values[i][0];
      const alias = values[i][1];
      
      // Users with H100 or high bits deserve better ranks
      if ((rank === 'H' && rankNumber === 100) || bits > 100) {
        usersToUpgrade.push({
          row: i + 1,
          ddsNumber: ddsNumber,
          alias: alias,
          currentRank: rank,
          currentNumber: rankNumber,
          bits: bits
        });
      }
    }
    
    if (usersToUpgrade.length === 0) {
      return createResponse(true, 'No users need rank upgrades');
    }
    
    // Sort by bits (descending) to give best ranks to most active users
    usersToUpgrade.sort((a, b) => b.bits - a.bits);
    
    let upgradedCount = 0;
    
    // Upgrade users starting from highest bits
    for (let i = 0; i < usersToUpgrade.length; i++) {
      const user = usersToUpgrade[i];
      const newRank = assignStartingRank(); // This will find the next available best rank
      
      // Update the user's rank
      profileSheet.getRange(user.row, 3).setValue(newRank.rank);  // Rank column
      profileSheet.getRange(user.row, 4).setValue(newRank.number); // Rank Number column
      
      // Update rankings sheet
      updateRankings(user.ddsNumber, newRank.rank, newRank.number);
      
      console.log(`Upgraded ${user.alias}: ${user.currentRank}${user.currentNumber} -> ${newRank.rank}${newRank.number}`);
      upgradedCount++;
    }
    
    return createResponse(true, `Successfully upgraded ${upgradedCount} users to better ranks`);
    
  } catch (error) {
    console.log('Error upgrading user ranks:', error);
    return createResponse(false, 'Error upgrading user ranks: ' + error.toString());
  }
}

