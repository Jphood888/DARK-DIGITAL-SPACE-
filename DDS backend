        insights.topProfessions[profession] = (insights.topProfessions[profession] || 0) + 1;
        totalBits += bits;

        if (joinDate > oneWeekAgo) {
          insights.recentTrends.newUsers++;
        }

        insights.activityMetrics.totalLikes += values[i][6] || 0;
        insights.activityMetrics.totalFollows += values[i][5] || 0;
      }

      insights.activityMetrics.avgBitsPerUser = Math.round(totalBits / insights.totalUsers);
    }

    const postsSheet = ss.getSheetByName(CONFIG.DDS_POSTS_SHEET);
    if (postsSheet && postsSheet.getDataRange().getNumRows() > 1) {
      const postValues = postsSheet.getDataRange().getValues();
      insights.activityMetrics.totalPosts = postValues.length - 1;

      const oneWeekAgo = new Date();
      oneWeekAgo.setDate(oneWeekAgo.getDate() - 7);

      for (let i = 1; i < postValues.length; i++) {
        const postDate = new Date(postValues[i][5]);
        if (postDate > oneWeekAgo) {
          insights.recentTrends.newPosts++;
        }
