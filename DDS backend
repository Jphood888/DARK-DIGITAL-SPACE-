      gameSessionsSheet.getRange(sessionRow, 5).setValue(data.hintsUsed || 0);
      gameSessionsSheet.getRange(sessionRow, 7).setValue(new Date());
      gameSessionsSheet.getRange(sessionRow, 10).setValue(JSON.stringify(data.attempts || []));
      gameSessionsSheet.getRange(sessionRow, 12).setValue(data.timeElapsed || 0);
      gameSessionsSheet.getRange(sessionRow, 15).setValue(JSON.stringify(gameStateData));
    }
    
    return createResponse(true, 'Game session saved', { sessionId: sessionId });

  } catch (error) {
    return createResponse(false, 'Error saving game session: ' + error.toString());
  }
}

