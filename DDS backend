function registerDDS(data) {
  try {
    // Validate required fields
    if (!data.ddsNumber || !data.alias || !data.password || !data.confirmPassword || !data.profession) {
      return createResponse(false, 'All fields are required');
    }

    if (data.password !== data.confirmPassword) {
      return createResponse(false, 'Passwords do not match');
    }
    
    const passwordCheck = isStrongPassword(data.password);
    if (!passwordCheck.valid) {
      return createResponse(false, passwordCheck.reason);
    }

    // Validate DDS number exists in approved users
    const userEmail = validateDDSNumber(data.ddsNumber);
    if (!userEmail) {
      return createResponse(false, 'Invalid DDS number');
    }

    // Check if alias is unique
    if (aliasExists(data.alias)) {
      return createResponse(false, 'Alias already taken. Please choose a different one.');
    }

    // Check if DDS number already has an account
    if (ddsAccountExists(data.ddsNumber)) {
      return createResponse(false, 'DDS number already has an account registered');
    }

    const ss = SpreadsheetApp.getActiveSpreadsheet();
    let sheet = ss.getSheetByName(CONFIG.DDS_ACCOUNTS_SHEET);

    if (!sheet) {
      sheet = ss.insertSheet(CONFIG.DDS_ACCOUNTS_SHEET);
      sheet.getRange(1, 1, 1, 6).setValues([['DDS Number', 'Email', 'Alias', 'Password Hash', 'Profession', 'Registration Date']]);
    }

    // Hash password (simple hash - in production use proper encryption)
    const passwordHash = hashPassword(data.password);

    sheet.appendRow([
      data.ddsNumber,
      userEmail,
      data.alias,
      passwordHash,
      data.profession,
      new Date()
    ]);

    return createResponse(true, 'DDS account created successfully');

  } catch (error) {
    return createResponse(false, 'Error creating account: ' + error.toString());
  }
}

function loginDDS(data) {
  try {
    if (!data.alias || !data.password) {
      return createResponse(false, 'Alias and password are required');
