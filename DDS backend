// ENHANCED approveApplication function to ensure proper data structure
function approveApplication(data) {
  try {
    if (!data.applicationId || !data.approved) {
      return createResponse(false, 'Missing required approval data');
    }

    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const pendingSheet = ss.getSheetByName(CONFIG.PENDING_SHEET);

    if (!pendingSheet) {
      return createResponse(false, 'Pending applications sheet not found');
    }

    const values = pendingSheet.getDataRange().getValues();

    for (let i = 1; i < values.length; i++) {
      if (values[i][5] === data.applicationId) { // Application ID column
        
        const currentStatus = values[i][4];
        if (currentStatus !== 'Pending') {
          return createResponse(false, `Application already processed. Current status: ${currentStatus}`);
        }

        if (data.approved === 'yes') {
          const ddsNumber = generateDDSNumber();

          if (ddsNumberExists(ddsNumber)) {
            return createResponse(false, 'Generated DDS number conflict. Please try again.');
          }

          // Move to approved sheet with proper structure
          let approvedSheet = ss.getSheetByName(CONFIG.APPROVED_SHEET);
          if (!approvedSheet) {
            approvedSheet = ss.insertSheet(CONFIG.APPROVED_SHEET);
            approvedSheet.getRange(1, 1, 1, 8).setValues([
              ['Timestamp', 'Email', 'WhatsApp', 'Country', 'DDS Number', 'Application ID', 'Approved Date', 'Approved By']
            ]);
          }

          // CRITICAL: Ensure data is in correct columns
          approvedSheet.appendRow([
            values[i][0], // Original timestamp
            values[i][1], // Email  
            values[i][2], // WhatsApp
            values[i][3], // Country
            ddsNumber,    // DDS Number (column 5, index 4)
            values[i][5], // Application ID (column 6, index 5)
            new Date(),   // Approved Date (column 7, index 6)
            'Admin'       // Approved By (column 8, index 7)
          ]);

          // Send DDS number to user
          sendDDSNumber(values[i][1], ddsNumber);

          // Update status in pending sheet
          pendingSheet.getRange(i + 1, 5).setValue('Approved');

          console.log('Backend: Application approved:', {
            applicationId: data.applicationId,
            email: values[i][1],
            ddsNumber: ddsNumber
          });

          return createResponse(true, `Application approved successfully. DDS Number ${ddsNumber} sent to user.`, {
            ddsNumber: ddsNumber,
            email: values[i][1]
          });
          
        } else {
          // Update status to rejected
          pendingSheet.getRange(i + 1, 5).setValue('Rejected');
          
          // Send rejection email
          sendRejectionEmail(values[i][1]);
          
          return createResponse(true, 'Application rejected and user notified.');
        }
      }
    }

    return createResponse(false, 'Application ID not found or invalid');

  } catch (error) {
    console.error('Backend: Error processing approval:', error);
    return createResponse(false, 'Error processing approval: ' + error.toString());
  }
