    );

    if (alreadyLiked) {
      return createResponse(false, 'You have already liked this profile');
    }

    // Add like interaction
    interactionsSheet.appendRow([data.userDDS, targetDDS, 'like', new Date(), data.userAlias]);

    // FIXED: Get user ranks for proper bits calculation
    const userProfile = getProfileByDDS(data.userDDS);
    const targetProfile = getProfileByDDS(targetDDS);

    if (!userProfile || !targetProfile) {
      return createResponse(false, 'User profile not found');
    }

    // FIXED: Award 4 bits to both users (no rank privileges for profile likes)
    awardBitsToUser(data.userDDS, 4); // User liking gets 4 bits
    awardBitsToUser(targetDDS, 4); // User being liked gets 4 bits

    // Update target profile likes count - ONLY ADD, NEVER SUBTRACT
    const profileValues = profileSheet.getDataRange().getValues();
    for (let i = 1; i < profileValues.length; i++) {
      if (profileValues[i][0] === targetDDS) {
        const currentLikes = profileValues[i][6] || 0;
