function cleanupExpiredOTPs() {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const otpSheet = ss.getSheetByName(CONFIG.OTP_SHEET);
    
    if (!otpSheet) return;
    
    const values = otpSheet.getDataRange().getValues();
    const now = new Date();
    let deletedCount = 0;
    
    // Delete from bottom to top to avoid index shifting
    for (let i = values.length - 1; i >= 1; i--) {
      const expiryTime = new Date(values[i][4]);
      if (now > expiryTime) {
        otpSheet.deleteRow(i + 1);
        deletedCount++;
      }
    }
    
    console.log(`Cleaned up ${deletedCount} expired OTPs`);
    
  } catch (error) {
    console.log('Error cleaning up expired OTPs:', error);
  }
