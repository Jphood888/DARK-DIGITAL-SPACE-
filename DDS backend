// 6. FIXED: Validate rank challenges
function isValidRankChallenge(challenger, target) {
  // Must be in same rank tier
  if (challenger.rank !== target.rank) {
    return false;
  }
  
  // Target must be exactly one position better (lower number = better position)
  return target.rankNumber === (challenger.rankNumber - 1);
}


