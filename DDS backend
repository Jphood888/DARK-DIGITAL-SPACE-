// ===================== HELPER FUNCTION TO GET BITS REWARD =====================
function getBitsReward(userRank, actionType) {
  const userBits = BITS_SYSTEM.ACTION_BITS[userRank] || BITS_SYSTEM.ACTION_BITS.default;
  return userBits[actionType] || 0;
}




function deductBitsFromUser(ddsNumber, bitsToDeduct) {
  try {
    if (bitsToDeduct === 0) return true;
    
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const profileSheet = ss.getSheetByName(CONFIG.DDS_PROFILES_SHEET);
    
    if (!profileSheet) return false;
    
    const values = profileSheet.getDataRange().getValues();
    for (let i = 1; i < values.length; i++) {
      if (values[i][0] === ddsNumber) {
        const currentBits = parseInt(values[i][7]) || 0;
        
        // Check if user has enough bits
        if (currentBits < bitsToDeduct) {
          return false;
        }
        
        const newBits = currentBits - parseInt(bitsToDeduct);
        profileSheet.getRange(i + 1, 8).setValue(newBits);
        console.log(`Deducted ${bitsToDeduct} bits from ${ddsNumber}. New total: ${newBits}`);
        return true;
      }
    }
    return false;
  } catch (error) {
    console.log('Error deducting bits:', error);
    return false;
  }
}



// ===================== ENHANCED RANKING FUNCTIONS =====================

function assignStartingRank() {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const profileSheet = ss.getSheetByName(CONFIG.DDS_PROFILES_SHEET);
    
    if (!profileSheet) {
      return { rank: 'R', number: 0 };
    }
    
    const values = profileSheet.getDataRange().getValues();
    const occupiedRanks = new Map();
    
    // Build map of occupied ranks
    for (let i = 1; i < values.length; i++) {
      const rank = values[i][2];
      const number = values[i][3];
      
      if (RANK_SYSTEM.BASIC_RANKS.includes(rank)) {
        if (!occupiedRanks.has(rank)) {
          occupiedRanks.set(rank, new Set());
        }
        occupiedRanks.get(rank).add(number);
      }
    }
    
    // FIXED: Check each rank tier completely before moving to next tier
    // Start from highest rank (R) and work down through each tier completely
    for (let rankIndex = RANK_SYSTEM.BASIC_RANKS.length - 1; rankIndex >= 0; rankIndex--) {
      const rank = RANK_SYSTEM.BASIC_RANKS[rankIndex];
      const occupied = occupiedRanks.get(rank) || new Set();
      
      // Check ALL positions in this rank tier (0-100) before moving to next tier
      for (let num = 0; num <= 100; num++) {
        if (!occupied.has(num)) {
          return { rank: rank, number: num };
        }
      }
      // Only continue to next rank tier if ALL 101 positions (0-100) are filled
    }
    
    // If all basic ranks are completely full, return last position
    return { rank: 'H', number: 100 };
    
  } catch (error) {
    console.log('Error assigning starting rank:', error);
    return { rank: 'H', number: 100 };
  }
}

// Enhanced challenge rank function with friendly challenges
function challengeRank(data) {
  try {
    console.log('Challenge request received:', data);
    
    if (!data.challengerDDS || !data.targetDDS || !data.challengeType) {
      return createResponse(false, 'Challenger DDS, target DDS, and challenge type are required');
    }

    // Get both profiles to validate they exist
    const challenger = getProfileByDDS(data.challengerDDS);
    const target = getProfileByDDS(data.targetDDS);

    if (!challenger) {
      return createResponse(false, 'Challenger profile not found');
    }
    
    if (!target) {
      return createResponse(false, 'Target profile not found');
    }

    console.log('Challenger:', challenger.alias, challenger.rank + challenger.rankNumber);
    console.log('Target:', target.alias, target.rank + target.rankNumber);

    const ss = SpreadsheetApp.getActiveSpreadsheet();
    let challengesSheet = ss.getSheetByName(CONFIG.DDS_CHALLENGES_SHEET);

    // Create challenges sheet if it doesn't exist
    if (!challengesSheet) {
      challengesSheet = ss.insertSheet(CONFIG.DDS_CHALLENGES_SHEET);
      challengesSheet.getRange(1, 1, 1, 10).setValues([
        ['Challenge ID', 'Challenger DDS', 'Target DDS', 'Challenge Type', 
         'Status', 'Created Date', 'Response Deadline', 'Result', 'Completed Date', 'Notes']
      ]);
    }

    // Process challenge based on type
    if (data.challengeType === 'friendly') {
      return processFriendlyChallenge(challenger, target, challengesSheet);
    } else if (data.challengeType === 'rank') {
      return processRankChallenge(challenger, target, challengesSheet);
    } else {
      return createResponse(false, 'Invalid challenge type. Use "friendly" or "rank"');
    }

  } catch (error) {
    console.error('Challenge error:', error);
    return createResponse(false, 'Error processing challenge: ' + error.toString());
  }
}

function processFriendlyChallenge(challenger, target, challengesSheet) {
  try {
    console.log('Processing friendly challenge');
    
    // CHARGE 10 BITS FOR FRIENDLY CHALLENGE
    if (!deductBitsFromUser(challenger.ddsNumber, 10)) {
      return createResponse(false, 'Insufficient bits! You need 10 bits to issue a friendly challenge.');
    }
    
    // Check cooldown for friendly challenges (24 hours)
    const yesterday = new Date();
    yesterday.setDate(yesterday.getDate() - 1);
    
    if (challengesSheet.getDataRange().getNumRows() > 1) {
      const values = challengesSheet.getDataRange().getValues();
      
      for (let i = 1; i < values.length; i++) {
        const challengeDate = new Date(values[i][5]);
        
        if (values[i][1] === challenger.ddsNumber && 
            values[i][3] === 'friendly' && 
            challengeDate > yesterday) {
          // Refund the bits since challenge couldn't proceed
          awardBitsToUser(challenger.ddsNumber, 10);
          return createResponse(false, 'You can only do one friendly challenge per day. Try again tomorrow!');
        }
      }
    }

    // Generate challenge ID
    const challengeId = 'FC-' + Date.now().toString(36).toUpperCase();
    
    // Set response deadline (19 hours from now)
    const deadline = new Date();
    deadline.setTime(deadline.getTime() + (19 * 60 * 60 * 1000));
    
    // Record the pending friendly challenge
    challengesSheet.appendRow([
      challengeId,
      challenger.ddsNumber,
      target.ddsNumber,
      'friendly',
      'pending',
      new Date(),
      deadline,
      null,
      null,
      `Friendly challenge from ${challenger.alias} to ${target.alias} (10 bits paid)`,
      null,
      null
    ]);

    // Create notification for target
    createNotification({
      recipientDDS: target.ddsNumber,
      type: 'friendly_challenge',
      content: `${challenger.alias} has challenged you to a friendly battle! They paid 10 bits. You have 19 hours to respond.`,
      sourceDDS: challenger.ddsNumber,
      sourceAlias: challenger.alias,
      referenceId: challengeId
    });
    
    return createResponse(true, 
      `Friendly challenge sent to ${target.alias}! 10 bits deducted. They have 19 hours to respond.`, 
      { 
        challengeId: challengeId,
        targetAlias: target.alias,
        deadline: deadline.toISOString(),
        status: 'pending',
        bitsPaid: 10
      }
    );

  } catch (error) {
    console.error('Friendly challenge error:', error);
    return createResponse(false, 'Error processing friendly challenge: ' + error.toString());
  }
}

function processRankChallenge(challenger, target, challengesSheet) {
  try {
    console.log('Processing rank challenge');
    
    // CHARGE 15 BITS FOR RANK CHALLENGE
    if (!deductBitsFromUser(challenger.ddsNumber, 15)) {
      return createResponse(false, 'Insufficient bits! You need 15 bits to issue a rank challenge.');
    }
    
    // Validate rank challenge rules
    if (!isValidRankChallenge(challenger, target)) {
      // Refund the bits since challenge is invalid
      awardBitsToUser(challenger.ddsNumber, 15);
      return createResponse(false, 'Invalid rank challenge. You can only challenge users in the same rank tier who are exactly one position above you. Bits refunded.');
    }

    // Check for existing pending challenges
    if (challengesSheet.getDataRange().getNumRows() > 1) {
      const values = challengesSheet.getDataRange().getValues();
      
      for (let i = 1; i < values.length; i++) {
        if (values[i][1] === challenger.ddsNumber && 
            values[i][2] === target.ddsNumber && 
            values[i][3] === 'rank' && 
            values[i][4] === 'pending') {
          // Refund the bits
          awardBitsToUser(challenger.ddsNumber, 15);
          return createResponse(false, 'You already have a pending rank challenge with this user. Bits refunded.');
        }
      }
    }

    // Generate challenge ID
    const challengeId = 'RC-' + Date.now().toString(36).toUpperCase();
    
    // Set response deadline (10 days from now)
    const deadline = new Date();
    deadline.setDate(deadline.getDate() + 10);
    
    // Record the rank challenge
    challengesSheet.appendRow([
      challengeId,
      challenger.ddsNumber,
      target.ddsNumber,
      'rank',
      'pending',
      new Date(),
      deadline,
      null,
      null,
      `Rank challenge: ${challenger.alias} (${challenger.rank}${challenger.rankNumber}) challenging ${target.alias} (${target.rank}${target.rankNumber}) - 15 bits paid`,
      null,
      null
    ]);

    // Create notification for target
    createNotification({
      recipientDDS: target.ddsNumber,
      type: 'rank_challenge',
      content: `${challenger.alias} has challenged you to a rank battle! They paid 15 bits. You have 10 days to respond or they win automatically.`,
      sourceDDS: challenger.ddsNumber,
      sourceAlias: challenger.alias,
      referenceId: challengeId
    });
    
    return createResponse(true, 
      `Rank challenge sent to ${target.alias}! 15 bits deducted. They have 10 days to respond or you win automatically.`, 
      { 
        challengeId: challengeId,
        targetAlias: target.alias,
        deadline: deadline.toISOString(),
        status: 'pending',
        bitsPaid: 15
      }
    );

  } catch (error) {
    console.error('Rank challenge error:', error);
    return createResponse(false, 'Error processing rank challenge: ' + error.toString());
  }
}

function isValidRankChallenge(challenger, target) {
  // Must be in same rank tier
  if (challenger.rank !== target.rank) {
    return false;
  }
  
  // Target must be exactly one position better (lower number = better position)
  return target.rankNumber === (challenger.rankNumber - 1);
}



function getAvailableChallengeTargets(userDDS) {
  try {
    const userProfile = getProfileByDDS(userDDS);
    if (!userProfile) return [];
    
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const profileSheet = ss.getSheetByName(CONFIG.DDS_PROFILES_SHEET);
    if (!profileSheet) return [];
    
    const values = profileSheet.getDataRange().getValues();
    const targets = [];
    
    // Find users in same rank tier who are one position better
    for (let i = 1; i < values.length; i++) {
      const profile = {
        ddsNumber: values[i][0],
        alias: values[i][1],
        rank: values[i][2],
        rankNumber: values[i][3],
        bits: values[i][7]
      };
      
      // Skip self
      if (profile.ddsNumber === userDDS) continue;
      
      // Check if this user can be challenged
      if (profile.rank === userProfile.rank && 
          profile.rankNumber === (userProfile.rankNumber - 1)) {
        targets.push({
          alias: profile.alias,
          rankNumber: profile.rankNumber,
          bits: profile.bits
        });
      }
    }
    
    return targets;
    
  } catch (error) {
    console.error('Error getting challenge targets:', error);
    return [];
  }
}

// Enhanced getRankProgression with proper challenge targets
function getRankProgressionGET(params) {
  try {
    if (!params.ddsNumber && !params.alias) {
      return createGETResponse(false, 'DDS Number or Alias is required');
    }

    const profile = getProfileByDDS(params.ddsNumber, params.alias);
    if (!profile) {
      return createGETResponse(false, 'User not found');
    }

    const currentRank = profile.rank;
    const currentNumber = profile.rankNumber;
    let nextRank = null;
    let canChallenge = false;
    const challengeTargets = [];

    if (RANK_SYSTEM.BASIC_RANKS.includes(currentRank)) {
      const rankIndex = RANK_SYSTEM.BASIC_RANKS.indexOf(currentRank);
      
      // Can challenge if not at position 0 in current rank
      if (currentNumber > 0) {
        canChallenge = true;
        
        // Get actual challenge targets
        const targets = getAvailableChallengeTargets(profile.ddsNumber);
        challengeTargets.push(...targets);
      }

      // Determine next rank tier
      if (rankIndex > 0 && currentNumber <= 10) {
        nextRank = RANK_SYSTEM.BASIC_RANKS[rankIndex - 1];
      } else if (rankIndex === 0 && currentNumber === 0) {
        nextRank = RANK_SYSTEM.ELDER_RANKS[0];
      }
    }

    const progression = {
      currentRank: currentRank,
      currentNumber: currentNumber,
      nextRank: nextRank,
      canChallenge: canChallenge,
      challengeTargets: challengeTargets,
      requirements: getAdvancementRequirements(currentRank, currentNumber)
    };

    return createGETResponse(true, 'Rank progression retrieved', { 
      user: profile.alias,
      progression: progression 
    });

  } catch (error) {
    return createGETResponse(false, 'Error retrieving rank progression: ' + error.toString());
  }
}




// Enhanced function to process expired challenges
function processExpiredChallenges() {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const challengesSheet = ss.getSheetByName(CONFIG.DDS_CHALLENGES_SHEET);

    if (!challengesSheet || challengesSheet.getDataRange().getNumRows() <= 1) {
      return createResponse(true, 'No challenges to process');
    }

    const values = challengesSheet.getDataRange().getValues();
    const now = new Date();
    let processedCount = 0;
    
    for (let i = 1; i < values.length; i++) {
      if (values[i][4] === 'pending' && values[i][3] === 'rank') {
        const deadline = new Date(values[i][6]);
        
        if (now > deadline) {
          // Challenge expired - challenger wins by default
          const challengerDDS = values[i][1];
          const targetDDS = values[i][2];
          const challengeId = values[i][0];
          
          console.log(`Processing expired challenge: ${challengeId}`);
          
          // Update challenge record
          challengesSheet.getRange(i + 1, 5).setValue('completed');
          challengesSheet.getRange(i + 1, 8).setValue('challenger_won');
          challengesSheet.getRange(i + 1, 9).setValue(new Date());
          challengesSheet.getRange(i + 1, 10).setValue('Auto-win: No response within 10 days');
          
          // Swap ranks (challenger wins by default)
          swapRanks(challengerDDS, targetDDS);
          
          // Award bits (reduced for auto-win)
          awardBitsToUser(challengerDDS, 20); // Auto-win reward
          // No bits for non-responsive target
          
          // Notify users
          const challengerProfile = getProfileByDDS(challengerDDS);
          const targetProfile = getProfileByDDS(targetDDS);
          
          if (challengerProfile) {
            createNotification({
              recipientDDS: challengerDDS,
              type: 'challenge_won',
              content: `You won your rank challenge by default! Your opponent didn't respond in time.`,
              referenceId: challengeId
            });
          }
          
          if (targetProfile) {
            createNotification({
              recipientDDS: targetDDS,
              type: 'challenge_lost',
              content: `You lost a rank challenge by not responding in time. Your position has been taken.`,
              referenceId: challengeId
            });
          }
          
          processedCount++;
          console.log(`Auto-win: ${challengerProfile?.alias || challengerDDS} defeated ${targetProfile?.alias || targetDDS}`);
        }
      }
    }

    return createResponse(true, `Processed ${processedCount} expired challenges`);

  } catch (error) {
    console.error('Error processing expired challenges:', error);
    return createResponse(false, 'Error processing expired challenges: ' + error.toString());
  }
}


