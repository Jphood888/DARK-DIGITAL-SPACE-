// CLEANUP: Remove duplicate applications (run manually if needed)
function CLEANUP_DUPLICATE_APPLICATIONS() {
  try {
    console.log('=== CLEANING UP DUPLICATES ===');
    
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const pendingSheet = ss.getSheetByName(CONFIG.PENDING_SHEET);
    
    if (!pendingSheet) {
      console.log('No pending sheet found');
      return;
    }
    
    const values = pendingSheet.getDataRange().getValues();
    const seen = new Set();
    const toDelete = [];
    
    for (let i = 1; i < values.length; i++) {
      const email = values[i][1];
      const phone = normalizePhoneNumber(values[i][2]);
      const key = `${email}|${phone}`;
      
      if (seen.has(key)) {
        toDelete.push(i + 1); // +1 for 1-based row indexing
        console.log(`Marking duplicate for deletion: row ${i + 1}, ${email}, ${phone}`);
      } else {
        seen.add(key);
      }
    }
    
    // Delete from bottom to top to avoid index shifting
    toDelete.reverse().forEach(rowIndex => {
      console.log(`Deleting row ${rowIndex}`);
      pendingSheet.deleteRow(rowIndex);
    });
    
    console.log(`Cleanup complete. Removed ${toDelete.length} duplicate applications.`);
    
  } catch (error) {
    console.error('Cleanup error:', error);
  }
}

// MONITORING: Function to check recent submissions for rapid fire
function checkRapidSubmissions() {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const pendingSheet = ss.getSheetByName(CONFIG.PENDING_SHEET);
    
    if (!pendingSheet) return;
    
    const values = pendingSheet.getDataRange().getValues();
    const fiveMinutesAgo = new Date(Date.now() - 5 * 60 * 1000);
    const recentSubmissions = [];
    
    for (let i = 1; i < values.length; i++) {
      const timestamp = new Date(values[i][0]);
      if (timestamp > fiveMinutesAgo) {
        recentSubmissions.push({
          timestamp: timestamp,
          email: values[i][1],
          phone: values[i][2],
          appId: values[i][5]
        });
      }
    }
    
    // Check for suspicious patterns
    const emailGroups = {};
    const phoneGroups = {};
    
    recentSubmissions.forEach(submission => {
      if (!emailGroups[submission.email]) emailGroups[submission.email] = [];
      if (!phoneGroups[submission.phone]) phoneGroups[submission.phone] = [];
      
      emailGroups[submission.email].push(submission);
      phoneGroups[submission.phone].push(submission);
    });
    
    // Alert on rapid submissions
    Object.keys(emailGroups).forEach(email => {
      if (emailGroups[email].length > 1) {
        console.log(`ALERT: ${email} submitted ${emailGroups[email].length} applications in last 5 minutes`);
      }
    });
    
    Object.keys(phoneGroups).forEach(phone => {
      if (phoneGroups[phone].length > 1) {
        console.log(`ALERT: ${phone} submitted ${phoneGroups[phone].length} applications in last 5 minutes`);
      }
    });
    
  } catch (error) {
    console.error('Rapid submission check error:', error);
  }
}


