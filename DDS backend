// *** SECURITY ENHANCEMENT: RATE LIMITING ***
function checkOTPRateLimit(email) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const otpSheet = ss.getSheetByName(CONFIG.OTP_SHEET);
    
    if (!otpSheet) return true;
    
    const values = otpSheet.getDataRange().getValues();
    const oneHourAgo = new Date(Date.now() - (60 * 60 * 1000));
    let recentCount = 0;
    
    for (let i = 1; i < values.length; i++) {
      if (values[i][0] === email) {
        const createdTime = new Date(values[i][3]);
        if (createdTime > oneHourAgo) {
          recentCount++;
        }
      }
    }
    
    const maxRequestsPerHour = 5; // Limit to 5 OTP requests per hour per email
    return recentCount < maxRequestsPerHour;
    
  } catch (error) {
    console.log('Error checking OTP rate limit:', error);
    return false;
  }
}

// *** SECURITY: CLEANUP EXPIRED OTPS REGULARLY ***
function cleanupExpiredOTPs() {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const otpSheet = ss.getSheetByName(CONFIG.OTP_SHEET);
    
    if (!otpSheet) return;
    
    const values = otpSheet.getDataRange().getValues();
    const now = new Date();
    let deletedCount = 0;
    
    // Delete from bottom to top to avoid index shifting
    for (let i = values.length - 1; i >= 1; i--) {
      const expiryTime = new Date(values[i][4]);
      if (now > expiryTime) {
        otpSheet.deleteRow(i + 1);
        deletedCount++;
      }
    }
    
    console.log(`Cleaned up ${deletedCount} expired OTPs`);
    
  } catch (error) {
    console.log('Error cleaning up expired OTPs:', error);
  }
}



