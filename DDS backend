      const values = profileSheet.getDataRange().getValues();
      const sameRankUsers = [];
      
      for (let i = 1; i < values.length; i++) {
        if (values[i][2] === profile.rank) {
          sameRankUsers.push({
            ddsNumber: values[i][0],
            rankNumber: values[i][3],
            bits: values[i][7]
          });
        }
      }

      if (RANK_SYSTEM.BASIC_RANKS.includes(profile.rank)) {
        // Sort by rank number (0 is highest)
        sameRankUsers.sort((a, b) => a.rankNumber - b.rankNumber);
      } else {
        // Sort by bits for elder/supreme ranks
        sameRankUsers.sort((a, b) => b.bits - a.bits);
      }

      rankPosition = sameRankUsers.findIndex(user => user.ddsNumber === profile.ddsNumber) + 1;
    }

    const userStats = {
      alias: profile.alias,
      rank: profile.rank,
      rankNumber: profile.rankNumber,
      rankPosition: rankPosition,
      profession: profile.profession,
