function swapRanks(challengerDDS, targetDDS) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const profileSheet = ss.getSheetByName(CONFIG.DDS_PROFILES_SHEET);
  const values = profileSheet.getDataRange().getValues();
  
  let challengerRow = -1;
  let targetRow = -1;
  let challengerRank, challengerNumber, targetRank, targetNumber;
  
  // Find both profiles
  for (let i = 1; i < values.length; i++) {
    if (values[i][0] === challengerDDS) {
      challengerRow = i + 1;
      challengerRank = values[i][2];
      challengerNumber = values[i][3];
    }
    if (values[i][0] === targetDDS) {
      targetRow = i + 1;
      targetRank = values[i][2];
      targetNumber = values[i][3];
    }
  }
  
  if (challengerRow !== -1 && targetRow !== -1) {
    // Swap ranks
    profileSheet.getRange(challengerRow, 3).setValue(targetRank);
    profileSheet.getRange(challengerRow, 4).setValue(targetNumber);
    profileSheet.getRange(targetRow, 3).setValue(challengerRank);
    profileSheet.getRange(targetRow, 4).setValue(challengerNumber);
    
    // Update rankings sheet
    updateRankings(challengerDDS, targetRank, targetNumber);
    updateRankings(targetDDS, challengerRank, challengerNumber);
  }
}

function awardBitsToUser(ddsNumber, bitsToAward) {
  try {
    if (bitsToAward === 0) return; // Don't process zero bits
    
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const profileSheet = ss.getSheetByName(CONFIG.DDS_PROFILES_SHEET);
    
    if (!profileSheet) {
      console.log('Profile sheet not found');
      return;
    }
    
    const values = profileSheet.getDataRange().getValues();
    for (let i = 1; i < values.length; i++) {
      if (values[i][0] === ddsNumber) {
        const currentBits = parseInt(values[i][7]) || 0;
        const newBits = currentBits + parseInt(bitsToAward);
        
        profileSheet.getRange(i + 1, 8).setValue(newBits);
        console.log(`Awarded ${bitsToAward} bits to ${ddsNumber}. New total: ${newBits}`);
        return;
      }
    }
  } catch (error) {
    console.log('Error awarding bits:', error);
  }
}

