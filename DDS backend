// ENHANCED: Phone normalization that matches frontend
function normalizePhoneNumber(phoneNumber) {
  if (!phoneNumber) return '';
  
  try {
    let normalized = phoneNumber.toString().trim();
    
    // Remove all non-digit characters except leading +
    if (normalized.startsWith('+')) {
      normalized = '+' + normalized.substring(1).replace(/[^\d]/g, '');
      // Remove the + for storage consistency
      normalized = normalized.substring(1);
    } else {
      normalized = normalized.replace(/[^\d]/g, '');
    }
    
    console.log('Phone normalization:', phoneNumber, '->', normalized);
    return normalized;
    
  } catch (error) {
    console.error('Error normalizing phone number:', error);
    return phoneNumber.toString().replace(/[^\d]/g, '');
  }
}

