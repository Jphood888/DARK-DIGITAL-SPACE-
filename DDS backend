function getRankingsGET(params) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const profileSheet = ss.getSheetByName(CONFIG.DDS_PROFILES_SHEET);
    
    if (!profileSheet) {
      return createGETResponse(false, 'No profiles found');
    }
    
    const values = profileSheet.getDataRange().getValues();
    const rankings = {
      basic: {},
      elder: [],
      supreme: [],
      emperor: null
    };
    
    // Group by rank type
    for (let i = 1; i < values.length; i++) {
      const rank = values[i][2];
      const profile = {
        alias: values[i][1],
        rankNumber: values[i][3],
        profession: values[i][4],
        bits: values[i][7],
        followers: values[i][5],
        likes: values[i][6]
      };
      
      if (RANK_SYSTEM.BASIC_RANKS.includes(rank)) {
        if (!rankings.basic[rank]) {
          rankings.basic[rank] = [];
        }
        rankings.basic[rank].push(profile);
      } else if (RANK_SYSTEM.ELDER_RANKS.includes(rank)) {
        rankings.elder.push({ ...profile, rank });
      } else if (RANK_SYSTEM.SUPREME_RANKS.includes(rank)) {
        rankings.supreme.push({ ...profile, rank });
      } else if (rank === RANK_SYSTEM.EMPEROR) {
        rankings.emperor = { ...profile, rank };
      }
    }
    
    // Sort basic ranks by rank number
    Object.keys(rankings.basic).forEach(rank => {
      rankings.basic[rank].sort((a, b) => a.rankNumber - b.rankNumber);
    });
    
    // Sort elder ranks by bits
    rankings.elder.sort((a, b) => b.bits - a.bits);
    
    // Sort supreme ranks by rank order
    rankings.supreme.sort((a, b) => {
      const aIndex = RANK_SYSTEM.SUPREME_RANKS.indexOf(a.rank);
      const bIndex = RANK_SYSTEM.SUPREME_RANKS.indexOf(b.rank);
      return aIndex - bIndex;
    });
    
    return createGETResponse(true, 'Rankings retrieved successfully', { rankings });
    
  } catch (error) {
    return createGETResponse(false, 'Error retrieving rankings: ' + error.toString());
  }
}

