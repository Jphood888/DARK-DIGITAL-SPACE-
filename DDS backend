    const profileSheet = ss.getSheetByName(CONFIG.DDS_PROFILES_SHEET);

    if (!profileSheet) {
      return createGETResponse(false, 'Profiles not found');
    }

    const values = profileSheet.getDataRange().getValues();
    const profiles = [];
    const limit = parseInt(params.limit) || 50;
    const sortBy = params.sortBy || 'bits';
for (let i = 1; i < values.length; i++) {
      profiles.push({
        alias: values[i][1],
        rank: values[i][2],
        rankNumber: values[i][3],
        profession: values[i][4],
        followers: values[i][5],
        likes: values[i][6],
