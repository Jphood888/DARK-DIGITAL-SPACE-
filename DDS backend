// NEW: Process game result from actual gameplay
function processGameResult(data, challengesSheet, rowIndex, challengerDDS, challengeType, challengerProfile, targetProfile) {
  try {
    const gameResult = data.gameResult;
    const challengerWins = gameResult.won; // This comes from actual game result
    
    // Update challenge with game results
    challengesSheet.getRange(rowIndex, 5).setValue('completed');
    challengesSheet.getRange(rowIndex, 8).setValue(challengerWins ? 'challenger_won' : 'target_won');
    challengesSheet.getRange(rowIndex, 9).setValue(new Date());
    
    // Add detailed game stats to notes
    const gameStats = `Game completed: ${gameResult.attempts} attempts, ${gameResult.hintsUsed} hints, ${gameResult.timeSeconds}s, difficulty ${gameResult.difficulty}`;
    challengesSheet.getRange(rowIndex, 10).setValue(gameStats);
    
    if (challengeType === 'friendly') {
      // Award bits based on performance
      if (challengerWins) {
        // Challenger (attacker) won
        const bonusBits = Math.max(15, 25 - gameResult.attempts - gameResult.hintsUsed); // Better performance = more bits
        awardBitsToUser(challengerDDS, bonusBits);
        awardBitsToUser(data.targetDDS, 5); // Participation bits
        
        // Notify both players
        createNotification({
          recipientDDS: challengerDDS,
          type: 'challenge_won',
          content: `You won the friendly challenge! Excellent hacking skills earned you ${bonusBits} bits!`,
          sourceDDS: data.targetDDS,
          sourceAlias: targetProfile?.alias || 'System',
          referenceId: data.challengeId
        });
        
        return createResponse(true, `Game completed! The challenger cracked your defense and earned ${bonusBits} bits. You earned 5 bits for participating.`);
        
      } else {
        // Defender won
        const defenseBonus = Math.max(10, 20 - Math.floor(gameResult.timeSeconds / 60)); // Faster defense holds = more bits
        awardBitsToUser(data.targetDDS, defenseBonus);
        awardBitsToUser(challengerDDS, 5); // Participation bits
        
        // Notify challenger
        createNotification({
          recipientDDS: challengerDDS,
          type: 'challenge_lost',
          content: `Your challenge was defended successfully! You earned 5 bits for the attempt.`,
          sourceDDS: data.targetDDS,
          sourceAlias: targetProfile?.alias || 'System',
          referenceId: data.challengeId
        });
        
        return createResponse(true, `Excellent defense! Your fortress held strong and you earned ${defenseBonus} bits!`);
      }
      
    } else if (challengeType === 'rank') {
      // Rank challenge with actual game results
      if (challengerWins) {
        return completeRankChallenge(challengesSheet, rowIndex, true, challengerDDS, data.targetDDS, challengerProfile, targetProfile, data.challengeId);
      } else {
        return completeRankChallenge(challengesSheet, rowIndex, false, challengerDDS, data.targetDDS, challengerProfile, targetProfile, data.challengeId);
      }
    }
    
  } catch (error) {
    console.error('Error processing game result:', error);
    return createResponse(false, 'Error processing game result: ' + error.toString());
  }
}

// Helper function for rank challenge completion
function completeRankChallenge(challengesSheet, rowIndex, challengerWins, challengerDDS, targetDDS, challengerProfile, targetProfile, challengeId) {
  if (challengerWins) {
    // Challenger wins rank battle - swap positions
    swapRanks(challengerDDS, targetDDS);
    challengesSheet.getRange(rowIndex, 10).setValue('Challenger won - ranks swapped');
    
    // Award bits for rank battle
    awardBitsToUser(challengerDDS, 30); // Winner gets substantial bits
    awardBitsToUser(targetDDS, 15); // Loser gets participation bits
    
    // Notify both users
    if (challengerProfile) {
      createNotification({
        recipientDDS: challengerDDS,
        type: 'challenge_won',
        content: `You won the rank challenge against ${targetProfile?.alias || 'defender'} and advanced your position! You earned 30 bits!`,
        sourceDDS: targetDDS,
        sourceAlias: targetProfile?.alias || 'System',
        referenceId: challengeId
      });
    }
    
    return createResponse(true, 'Rank challenge completed! The challenger won and ranks have been swapped. You earned 15 bits.');
    
  } else {
    // Target wins rank challenge
    challengesSheet.getRange(rowIndex, 10).setValue('Defender successfully defended position');
    
    // Award bits
    awardBitsToUser(targetDDS, 25);   // Defender gets good bits for winning
    awardBitsToUser(challengerDDS, 10);    // Challenger gets participation bits
    
    // Notify challenger about loss
    if (challengerProfile) {
      createNotification({
        recipientDDS: challengerDDS,
        type: 'challenge_lost',
        content: `Your rank challenge was defended successfully. You earned 10 bits for participating.`,
        sourceDDS: targetDDS,
        sourceAlias: targetProfile?.alias || 'System',
        referenceId: challengeId
      });
    }
    
    return createResponse(true, 'Rank challenge completed! You successfully defended your position and earned 25 bits!');
  }
}

