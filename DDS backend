function generateSecurityCode() {
  // Generate 6-digit security code
  return Math.floor(100000 + Math.random() * 900000).toString();
}

function forgotPasswordWithSecurityQuestion(data) {
  try {
    if (!data.email || !data.ddsNumber) {
      return createResponse(false, 'Email and DDS number are required');
    }

    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheetByName(CONFIG.DDS_ACCOUNTS_SHEET);

    if (!sheet) {
      return createResponse(false, 'No DDS accounts found');
    }

    const data_range = sheet.getDataRange();
    const values = data_range.getValues();

    for (let i = 1; i < values.length; i++) {
      if (values[i][0] === data.ddsNumber && values[i][1] === data.email) {
        
        // Generate a security code
        const securityCode = generateSecurityCode();
        const codeExpiry = new Date(Date.now() + 15 * 60 * 1000); // 15 minutes
        
        // Store security code temporarily
        const currentCols = sheet.getLastColumn();
        if (currentCols < 8) {
          if (currentCols === 6) {
            sheet.getRange(1, 7).setValue('Security Code');
            sheet.getRange(1, 8).setValue('Code Expiry');
          }
        }
        
        sheet.getRange(i + 1, 7).setValue(securityCode);
        sheet.getRange(i + 1, 8).setValue(codeExpiry);
        
        // Send security code via email
        sendSecurityCodeEmail(data.email, securityCode, values[i][2]);
        
        return createResponse(true, 'Security code sent to your email. Code expires in 15 minutes.');
      }
    }

    return createResponse(false, 'No account found with provided email and DDS number');

  } catch (error) {
    return createResponse(false, 'Error processing password reset: ' + error.toString());
  }
}

function resetPasswordWithSecurityCode(data) {
  try {
    if (!data.email || !data.ddsNumber || !data.securityCode || !data.newPassword || !data.confirmPassword) {
      return createResponse(false, 'All fields are required');
    }

    if (data.newPassword !== data.confirmPassword) {
      return createResponse(false, 'Passwords do not match');
    }

    const passwordCheck = isStrongPassword(data.newPassword);
    if (!passwordCheck.valid) {
      return createResponse(false, passwordCheck.reason);
    }

    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheetByName(CONFIG.DDS_ACCOUNTS_SHEET);
    const data_range = sheet.getDataRange();
    const values = data_range.getValues();

    for (let i = 1; i < values.length; i++) {
      if (values[i][0] === data.ddsNumber && values[i][1] === data.email) {
        
        const totalCols = sheet.getLastColumn();
        if (totalCols < 8) {
          return createResponse(false, 'No security code found. Please request a new code.');
        }
        
        const storedCode = String(values[i][6]).trim();
        const codeExpiry = values[i][7];
        
        if (!storedCode || storedCode === '' || storedCode === 'undefined') {
          return createResponse(false, 'No security code found. Please request a new code.');
        }
        
        if (storedCode !== String(data.securityCode).trim()) {
          return createResponse(false, 'Invalid security code');
        }
        
        if (!codeExpiry || new Date() > new Date(codeExpiry)) {
          sheet.getRange(i + 1, 7).setValue('');
          sheet.getRange(i + 1, 8).setValue('');
          return createResponse(false, 'Security code has expired. Please request a new code.');
        }

        // Update password and clear security code
        const passwordHash = hashPassword(data.newPassword);
        sheet.getRange(i + 1, 4).setValue(passwordHash);
        sheet.getRange(i + 1, 7).setValue('');
        sheet.getRange(i + 1, 8).setValue('');

        // Send confirmation email
        sendPasswordChangedEmail(data.email, values[i][2]);

        return createResponse(true, 'Password updated successfully');
      }
    }

    return createResponse(false, 'Invalid details provided');

  } catch (error) {
    console.log('Reset password error:', error);
    return createResponse(false, 'Error resetting password: ' + error.toString());
  }
}

