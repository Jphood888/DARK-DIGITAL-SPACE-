function likeProfile(data) {
  try {
    if (!data.targetDDS || !data.userDDS) {
      return createResponse(false, 'Target and user DDS numbers are required');
    }

    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const profileSheet = ss.getSheetByName(CONFIG.DDS_PROFILES_SHEET);
    let interactionsSheet = ss.getSheetByName(CONFIG.DDS_INTERACTIONS_SHEET);

    if (!interactionsSheet) {
      interactionsSheet = ss.insertSheet(CONFIG.DDS_INTERACTIONS_SHEET);
      interactionsSheet.getRange(1, 1, 1, 4).setValues([
        ['User DDS', 'Target DDS', 'Action', 'Date']
      ]);
    }

    // Check if already liked
    const interactions = interactionsSheet.getDataRange().getValues();
    const alreadyLiked = interactions.some(row => 
      row[0] === data.userDDS && row[1] === data.targetDDS && row[2] === 'like'
    );

    if (alreadyLiked) {
      return createResponse(false, 'You have already liked this profile');
    }

    // Add like interaction
    interactionsSheet.appendRow([data.userDDS, data.targetDDS, 'like', new Date()]);

    // FIXED: Award bits directly instead of recalculating
    awardBitsToUser(data.userDDS, 4);    // User doing the liking gets 4 bits
    awardBitsToUser(data.targetDDS, 4);  // User being liked gets 4 bits

    // Update target profile likes count - ONLY ADD, DON'T RECALCULATE BITS
    const profileValues = profileSheet.getDataRange().getValues();
    for (let i = 1; i < profileValues.length; i++) {
      if (profileValues[i][0] === data.targetDDS) {
        const currentLikes = profileValues[i][6] || 0;
        profileSheet.getRange(i + 1, 7).setValue(currentLikes + 1);
        // DON'T update bits here - already done above
        break;
      }
    }

    return createResponse(true, 'Profile liked successfully');

  } catch (error) {
    return createResponse(false, 'Error liking profile: ' + error.toString());
  }
}

function followUserWithNotification(data) {
  try {
    if (!data.userDDS || !data.targetAlias || !data.userAlias) {
      return createResponse(false, 'User DDS, target alias, and user alias are required');
    }

    const targetProfile = getProfileByDDS(null, data.targetAlias);
    if (!targetProfile) {
      return createResponse(false, 'Target user not found');
    }

    if (targetProfile.ddsNumber === data.userDDS) {
      return createResponse(false, 'You cannot follow yourself');
    }

    const ss = SpreadsheetApp.getActiveSpreadsheet();
    let interactionsSheet = ss.getSheetByName(CONFIG.DDS_INTERACTIONS_SHEET);

    if (!interactionsSheet) {
      interactionsSheet = ss.insertSheet(CONFIG.DDS_INTERACTIONS_SHEET);
      interactionsSheet.getRange(1, 1, 1, 5).setValues([
        ['User DDS', 'Target DDS', 'Action', 'Date', 'User Alias']
      ]);
    }

    // Check if already following
    const interactions = interactionsSheet.getDataRange().getValues();
    const alreadyFollowing = interactions.some(row => 
      row[0] === data.userDDS && row[1] === targetProfile.ddsNumber && row[2] === 'follow'
    );

    if (alreadyFollowing) {
      return createResponse(false, 'You are already following this user');
    }

    // Add follow interaction
    interactionsSheet.appendRow([data.userDDS, targetProfile.ddsNumber, 'follow', new Date(), data.userAlias]);

    // FIXED: Award bits - follower gets 3 bits, followed user gets 5 bits
    awardBitsToUser(data.userDDS, 3); // Person doing the following
    awardBitsToUser(targetProfile.ddsNumber, 5); // Person being followed

    // Update target profile followers count - ONLY ADD, NEVER SUBTRACT
    const profileSheet = ss.getSheetByName(CONFIG.DDS_PROFILES_SHEET);
    const profileValues = profileSheet.getDataRange().getValues();
    
    for (let i = 1; i < profileValues.length; i++) {
      if (profileValues[i][0] === targetProfile.ddsNumber) {
        const currentFollowers = profileValues[i][5] || 0;
        profileSheet.getRange(i + 1, 6).setValue(currentFollowers + 1);
        break;
      }
    }

    // Create notification
    createNotification({
      recipientDDS: targetProfile.ddsNumber,
      type: 'follow',
      content: `${data.userAlias} started following you`,
      sourceDDS: data.userDDS,
      sourceAlias: data.userAlias,
      referenceId: data.userDDS
    });

    return createResponse(true, 'User followed successfully! You earned 3 bits.');

  } catch (error) {
    return createResponse(false, 'Error following user: ' + error.toString());
  }
}

    

