function getRankProgressionGET(params) {
  try {
    if (!params.ddsNumber && !params.alias) {
      return createGETResponse(false, 'DDS Number or Alias is required');
    }

    const profile = getProfileByDDS(params.ddsNumber, params.alias);
    if (!profile) {
      return createGETResponse(false, 'User not found');
    }

    const currentRank = profile.rank;
    const currentNumber = profile.rankNumber;
    let nextRank = null;
    let canChallenge = [];
    let challengeable = false;

    if (RANK_SYSTEM.BASIC_RANKS.includes(currentRank)) {
      const rankIndex = RANK_SYSTEM.BASIC_RANKS.indexOf(currentRank);
      
      // Can challenge within same rank (lower numbers)
      if (currentNumber > 0) {
        challengeable = true;
        // Get users in same rank with lower numbers
        const ss = SpreadsheetApp.getActiveSpreadsheet();
        const profileSheet = ss.getSheetByName(CONFIG.DDS_PROFILES_SHEET);
        if (profileSheet) {
          const values = profileSheet.getDataRange().getValues();
          for (let i = 1; i < values.length; i++) {
            if (values[i][2] === currentRank && values[i][3] < currentNumber) {
              canChallenge.push({
                alias: values[i][1],
                rankNumber: values[i][3],
                bits: values[i][7]
              });
            }
          }
          canChallenge.sort((a, b) => b.rankNumber - a.rankNumber); // Closest first
        }
      }

      // Next rank tier
      if (rankIndex > 0 && currentNumber <= 10) { // Only top 10 can advance
        nextRank = RANK_SYSTEM.BASIC_RANKS[rankIndex - 1];
      } else if (rankIndex === 0 && currentNumber === 0) {
        nextRank = RANK_SYSTEM.ELDER_RANKS[0]; // First elder rank
      }
    }

    const progression = {
      currentRank: currentRank,
      currentNumber: currentNumber,
      nextRank: nextRank,
      canChallenge: challengeable,
      challengeTargets: canChallenge.slice(0, 5), // Top 5 closest targets
      requirements: getAdvancementRequirements(currentRank, currentNumber)
    };

    return createGETResponse(true, 'Rank progression retrieved', { 
      user: profile.alias,
      progression: progression 
    });

  } catch (error) {
    return createGETResponse(false, 'Error retrieving rank progression: ' + error.toString());
  }
}

function getAdvancementRequirements(rank, number) {
  if (RANK_SYSTEM.BASIC_RANKS.includes(rank)) {
    if (number > 0) {
      return {
        type: 'challenge',
        description: `Challenge users with rank ${rank}${number-1} or better`,
        minBits: null
      };
    } else if (rank !== 'R') {
      return {
        type: 'promotion',
        description: 'Eligible for elder rank promotion',
        minBits: 1000
      };
    }
  } else if (RANK_SYSTEM.ELDER_RANKS.includes(rank)) {
    return {
      type: 'performance',
      description: 'High activity and community contribution required',
      minBits: 5000
    };
  }
  
  return {
    type: 'maximum',
    description: 'Highest achievable rank reached',
    minBits: null
  };
}

function getCommunityInsightsGET(params) {
