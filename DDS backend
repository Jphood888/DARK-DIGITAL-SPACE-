function getAllProfiles(data) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const profileSheet = ss.getSheetByName(CONFIG.DDS_PROFILES_SHEET);

    if (!profileSheet) {
      return createResponse(false, 'Profiles not found');
    }

    const values = profileSheet.getDataRange().getValues();
    const profiles = [];
    const limit = data && data.limit ? parseInt(data.limit) : 50;
    const sortBy = data && data.sortBy ? data.sortBy : 'bits';

    for (let i = 1; i < values.length; i++) {
      profiles.push({
        alias: values[i][1],
        rank: values[i][2],
        rankNumber: values[i][3],
        profession: values[i][4],
        followers: values[i][5],
        likes: values[i][6],
        bits: values[i][7],
        avatar: values[i][9]
      });
    }

    // Sort profiles
    switch(sortBy) {
      case 'followers':
        profiles.sort((a, b) => b.followers - a.followers);
        break;
      case 'likes':
        profiles.sort((a, b) => b.likes - a.likes);
        break;
      case 'rank':
        profiles.sort((a, b) => {
          if (a.rank !== b.rank) {
            return RANK_SYSTEM.BASIC_RANKS.indexOf(a.rank) - RANK_SYSTEM.BASIC_RANKS.indexOf(b.rank);
          }
          return a.rankNumber - b.rankNumber;
        });
        break;
      default: // bits
        profiles.sort((a, b) => b.bits - a.bits);
    }

    return createResponse(true, 'Profiles retrieved successfully', { 
      profiles: profiles.slice(0, limit),
      total: profiles.length
    });

  } catch (error) {
    return createResponse(false, 'Error retrieving profiles: ' + error.toString());
  }
}
