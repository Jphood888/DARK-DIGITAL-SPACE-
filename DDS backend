function completeGameSession(data) {
  try {
    if (!data.challengeId || !data.gameResult) {
      return createResponse(false, 'Challenge ID and game result are required');
    }

    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const challengesSheet = ss.getSheetByName('DDS Challenges');

    if (!challengesSheet) {
      return createResponse(false, 'No challenges found');
    }

    const values = challengesSheet.getDataRange().getValues();
    
    for (let i = 1; i < values.length; i++) {
      if (values[i][0] === data.challengeId && values[i][4] === 'accepted') {
        const challengerDDS = values[i][1];
        const targetDDS = values[i][2];
        const challengeType = values[i][3];
        const challengerWins = data.gameResult.won;
        
        // Update challenge completion
        challengesSheet.getRange(i + 1, 5).setValue('completed');
        challengesSheet.getRange(i + 1, 8).setValue(challengerWins ? 'challenger_won' : 'target_won');
        challengesSheet.getRange(i + 1, 9).setValue(new Date());
        challengesSheet.getRange(i + 1, 12).setValue(JSON.stringify(data.gameResult));
        
        const gameStats = `Attempts: ${data.gameResult.attempts}, Time: ${data.gameResult.timeSeconds}s, Difficulty: ${data.gameResult.difficulty}`;
        challengesSheet.getRange(i + 1, 10).setValue(`Game completed - ${gameStats}`);
        
        // Award bits based on performance
        let challengerBits = 0;
        let defenderBits = 0;
        
        if (challengeType === 'friendly') {
          if (challengerWins) {
            challengerBits = Math.max(15, 25 - data.gameResult.attempts);
            defenderBits = 5;
          } else {
            defenderBits = Math.max(15, 25 - Math.floor(data.gameResult.timeSeconds / 30));
            challengerBits = 5;
          }
        } else if (challengeType === 'rank') {
          if (challengerWins) {
            swapRanks(challengerDDS, targetDDS);
            challengerBits = 30;
            defenderBits = 15;
          } else {
            challengerBits = 10;
            defenderBits = 25;
          }
        }
        
        // Award the bits
        if (challengerBits > 0) awardBitsToUser(challengerDDS, challengerBits);
        if (defenderBits > 0) awardBitsToUser(targetDDS, defenderBits);
        
        // Create notifications
        const challengerProfile = getProfileByDDS(challengerDDS);
        const targetProfile = getProfileByDDS(targetDDS);
        
        createNotification({
          recipientDDS: challengerDDS,
          type: challengerWins ? 'challenge_won' : 'challenge_lost',
          content: challengerWins ? 
            `You won the ${challengeType} challenge against ${targetProfile?.alias || 'defender'}! Earned ${challengerBits} bits.` :
            `You lost the ${challengeType} challenge. Earned ${challengerBits} bits for participating.`,
          sourceDDS: targetDDS,
          sourceAlias: targetProfile?.alias || 'System',
          referenceId: data.challengeId
        });
        
        createNotification({
          recipientDDS: targetDDS,
          type: challengerWins ? 'challenge_lost' : 'challenge_won',
          content: challengerWins ? 
            `Your defense was breached by ${challengerProfile?.alias || 'challenger'}! Earned ${defenderBits} bits for participating.` :
            `Excellent defense against ${challengerProfile?.alias || 'challenger'}! You earned ${defenderBits} bits for winning.`,
          sourceDDS: challengerDDS,
          sourceAlias: challengerProfile?.alias || 'System',
          referenceId: data.challengeId
        });
        
        return createResponse(true, 'Game session completed successfully', {
          challengerWins: challengerWins,
          challengerBits: challengerBits,
          defenderBits: defenderBits
        });
      }
    }

    return createResponse(false, 'Challenge not found or not in accepted state');

  } catch (error) {
    console.error('Error completing game session:', error);
    return createResponse(false, 'Error completing game session: ' + error.toString());
  }
}







 

