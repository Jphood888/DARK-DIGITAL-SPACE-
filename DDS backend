    let bits = 0;
    
    if (challengeType === 'friendly') {
      if (won) {
        bits = Math.max(15, 25 - (performance.attempts || 0) - (performance.hintsUsed || 0));
      } else {
        bits = 5; // participation
      }
    } else if (challengeType === 'rank') {
      if (won) {
        bits = 30; // substantial reward for rank advancement
      } else {
        bits = 15; // good participation reward
      }
    }
    
    if (bits > 0) {
      awardBitsToUser(userDDS, bits);
      
      // Create bits notification
      const userProfile = getProfileByDDS(userDDS);
      if (userProfile) {
        createNotification({
          recipientDDS: userDDS,
          type: 'bits_earned',
          content: `You earned ${bits} bits from your ${challengeType} challenge!`,
          sourceDDS: 'SYSTEM',
          sourceAlias: 'DDS System',
          referenceId: 'BITS-' + Date.now()
        });
      }
    }
    
    return bits;
  } catch (error) {
    console.error('Error awarding challenge reward:', error);
    return 0;
  }
}


// 3. Process game completion with results
function processGameCompletion(data, challengesSheet, rowIndex, challengerDDS, challengeType, challengerProfile, targetProfile) {
  try {
    const gameResult = data.gameResult;
    const challengerWins = gameResult.won;
    const challengeId = data.challengeId;
    
    // Update challenge with completion
    challengesSheet.getRange(rowIndex, 5).setValue('completed');
    challengesSheet.getRange(rowIndex, 8).setValue(challengerWins ? 'challenger_won' : 'defender_won');
    challengesSheet.getRange(rowIndex, 9).setValue(new Date());
    
    // Create detailed results
    const gameStats = `Attempts: ${gameResult.attempts}, Time: ${gameResult.timeSeconds}s, Difficulty: ${gameResult.difficulty}`;
    challengesSheet.getRange(rowIndex, 10).setValue(`Game completed - ${gameStats}`);
    
    let challengerBits = 0;
    let defenderBits = 0;
    let resultMessage = '';
    
    if (challengeType === 'friendly') {
      if (challengerWins) {
        // Challenger (attacker) won
        challengerBits = Math.max(15, 25 - gameResult.attempts); // Better performance = more bits
        defenderBits = 5; // Participation bits
        resultMessage = `Friendly challenge completed! The challenger cracked your defense and earned ${challengerBits} bits. You earned ${defenderBits} bits for participating.`;
        
        // Notify challenger
        createNotification({
          recipientDDS: challengerDDS,
          type: 'challenge_won',
          content: `You won the friendly challenge against ${targetProfile?.alias || 'defender'}! You earned ${challengerBits} bits!`,
          sourceDDS: data.targetDDS,
          sourceAlias: targetProfile?.alias || 'System',
          referenceId: challengeId
        });
        
      } else {
        // Defender won
        defenderBits = Math.max(15, 25 - Math.floor(gameResult.timeSeconds / 30)); // Faster defense = more bits
        challengerBits = 5; // Participation bits
        resultMessage = `Excellent defense! Your fortress held strong and you earned ${defenderBits} bits!`;
        
        // Notify challenger
        createNotification({
          recipientDDS: challengerDDS,
          type: 'challenge_lost',
          content: `Your friendly challenge was defended successfully. You earned ${challengerBits} bits for participating.`,
          sourceDDS: data.targetDDS,
          sourceAlias: targetProfile?.alias || 'System',
          referenceId: challengeId
        });
      }
      
    } else if (challengeType === 'rank') {
      if (challengerWins) {
        // Rank challenge won - swap positions
        swapRanks(challengerDDS, data.targetDDS);
        challengerBits = 30;
        defenderBits = 15;
        resultMessage = `Rank challenge completed! The challenger won and ranks have been swapped. You earned ${defenderBits} bits.`;
        
        // Notify both about rank change
        createNotification({
          recipientDDS: challengerDDS,
          type: 'rank_promotion',
          content: `Congratulations! You won the rank challenge and advanced your position! You earned ${challengerBits} bits!`,
          sourceDDS: data.targetDDS,
          sourceAlias: targetProfile?.alias || 'System',
          referenceId: challengeId
        });
        
        createNotification({
          recipientDDS: data.targetDDS,
          type: 'rank_demotion',
          content: `You have been demoted due to losing a rank challenge. You earned ${defenderBits} bits for participating.`,
          sourceDDS: challengerDDS,
          sourceAlias: challengerProfile?.alias || 'System',
          referenceId: challengeId
        });
        
      } else {
        // Defender won rank challenge
        defenderBits = 25;
        challengerBits = 10;
        resultMessage = `Rank challenge completed! You successfully defended your position and earned ${defenderBits} bits!`;
        
        // Notify challenger
        createNotification({
          recipientDDS: challengerDDS,
          type: 'challenge_lost',
          content: `Your rank challenge was defended successfully. You earned ${challengerBits} bits for participating.`,
          sourceDDS: data.targetDDS,
          sourceAlias: targetProfile?.alias || 'System',
          referenceId: challengeId
        });
      }
    }
    
    // Award the bits
    if (challengerBits > 0) awardBitsToUser(challengerDDS, challengerBits);
    if (defenderBits > 0) awardBitsToUser(data.targetDDS, defenderBits);
    
    return createResponse(true, resultMessage, {
      won: !challengerWins, // From defender's perspective
      challengerWins: challengerWins,
      bitsEarned: defenderBits,
      gameResult: gameResult
    });
    
  } catch (error) {
    console.error('Error processing game completion:', error);
    return createResponse(false, 'Error processing game completion: ' + error.toString());
  }
}



