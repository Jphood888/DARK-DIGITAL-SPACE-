// Helper function to create historical notifications with original dates
function createHistoricalNotification(data) {
  try {
    if (!data.recipientDDS || !data.type || !data.content) {
      return false;
    }

    const ss = SpreadsheetApp.getActiveSpreadsheet();
    let notificationsSheet = ss.getSheetByName('DDS Notifications');

    if (!notificationsSheet) {
      notificationsSheet = ss.insertSheet('DDS Notifications');
      notificationsSheet.getRange(1, 1, 1, 10).setValues([
        ['Notification ID', 'Recipient DDS', 'Type', 'Content', 'Source DDS', 
         'Source Alias', 'Reference ID', 'Read', 'Created Date', 'Read Date']
      ]);
    }

    // Check if this notification already exists to avoid duplicates
    const existingValues = notificationsSheet.getDataRange().getValues();
    for (let i = 1; i < existingValues.length; i++) {
      if (existingValues[i][1] === data.recipientDDS && 
          existingValues[i][2] === data.type && 
          existingValues[i][4] === data.sourceDDS && 
          existingValues[i][6] === data.referenceId) {
        console.log('Duplicate notification found, skipping...');
        return false;
      }
    }

    const notificationId = 'HIST-' + Date.now().toString(36).toUpperCase();

    notificationsSheet.appendRow([
      notificationId,
      data.recipientDDS,
      data.type,
      data.content,
      data.sourceDDS || '',
      data.sourceAlias || '',
      data.referenceId || '',
      false, // unread by default
      data.originalDate || new Date(), // Use original date if provided
      null // read date
    ]);

    return true;

  } catch (error) {
    console.log('Error creating historical notification:', error.toString());
    return false;
  }
}

