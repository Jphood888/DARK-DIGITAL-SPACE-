function getChallengeHistoryGET(params) {
  try {
    if (!params.ddsNumber) {
      return createGETResponse(false, 'DDS Number is required');
    }

    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const challengesSheet = ss.getSheetByName(CONFIG.DDS_CHALLENGES_SHEET);

    if (!challengesSheet) {
      return createGETResponse(true, 'No challenge history found', { history: [] });
    }

    const values = challengesSheet.getDataRange().getValues();
    const history = [];
    const limit = parseInt(params.limit) || 20;

    for (let i = 1; i < values.length; i++) {
      if (values[i][1] === params.ddsNumber || values[i][2] === params.ddsNumber) {
        const isChallenger = values[i][1] === params.ddsNumber;
        const opponentDDS = isChallenger ? values[i][2] : values[i][1];
        const opponentProfile = getProfileByDDS(opponentDDS);
        
        let result = 'pending';
        if (values[i][4] === 'completed') {
          if (values[i][7] === 'challenger_won') {
            result = isChallenger ? 'won' : 'lost';
          } else if (values[i][7] === 'target_won') {
            result = isChallenger ? 'lost' : 'won';
          }
        } else if (values[i][4] === 'declined') {
          result = 'declined';
        }

        history.push({
          challengeId: values[i][0],
          opponent: opponentProfile ? {
            alias: opponentProfile.alias,
            rank: opponentProfile.rank,
            rankNumber: opponentProfile.rankNumber
          } : { alias: 'Unknown' },
          challengeType: values[i][3],
          role: isChallenger ? 'challenger' : 'target',
          result: result,
          createdDate: values[i][5],
          completedDate: values[i][8],
          notes: values[i][9]
        });
      }
    }

    // Sort by date (newest first)
    history.sort((a, b) => new Date(b.createdDate) - new Date(a.createdDate));

    return createGETResponse(true, 'Challenge history retrieved', { 
      history: history.slice(0, limit),
      total: history.length
    });

  } catch (error) {
    return createGETResponse(false, 'Error retrieving challenge history: ' + error.toString());
  }
}

